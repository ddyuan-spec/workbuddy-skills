{
  "_comment": "每个截图文件 → 触发脚本 + 截图窗口尺寸。trigger 为空字符串''表示原型默认视图（无需触发）。",
  "proto": "../你的原型.html",
  "assets_dir": "hlz-prd-assets",
  "shots": {
    "plat-list.png":        { "trigger": "", "size": [1280, 900] },
    "plat-modal.png":       { "trigger": "openModal();", "size": [1280, 900] },
    "plat-detail.png":      { "trigger": "showDetail(0);", "size": [1280, 900] },
    "app-home.png":         { "trigger": "toggleView(true);", "size": [414, 820] },
    "app-sub.png":          { "trigger": "toggleView(true); showScreen('sub');", "size": [414, 820] }
  }
}
